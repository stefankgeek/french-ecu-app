  "inserts": {
    "title": "Thread inserts (helical coil)",
    "desc": "Thread repair: STI drills and taps, lengths, installation and materials.",
    "i1": {
      "title": "STI drill and tap",
      "b1": {
        "h1": "Repaired thread",
        "h2": "STI drill (mm)",
        "h3": "Tap",
        "h4": "Insert lengths"
      },
      "b2": {
        "t": "STI = Screw Thread Insert. Drill ≈ nominal diameter + ¼ of the pitch (rounded to a standard drill); check the kit instructions. M14x1.25 is the spark plug thread."
      }
    },
    "i2": {
      "title": "Installing a helical insert",
      "b1": {
        "l1": "Drill to the STI size, perfectly square.",
        "l2": "Tap with the STI tap, lubricated, backing off half a turn to break the chip.",
        "l3": "Blow out and clean the thread.",
        "l4": "Screw the insert in with the installation tool to ¼ to ½ turn below the surface.",
        "l5": "Break off the drive tang with a punch (tanged inserts).",
        "l6": "Check with a bolt: it must run in without tight spots."
      },
      "b2": {
        "t": "Stainless insert in aluminium: apply anti-seize compound to prevent galvanic corrosion. Do not remove and refit an insert: it is designed as a permanent repair."
      }
    },
    "i3": {
