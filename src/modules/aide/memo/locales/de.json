  "inserts": {
    "title": "Gewindeeinsätze (Drahtgewinde)",
    "desc": "Gewindereparatur: STI-Bohrer und Gewindebohrer, Längen, Einbau und Werkstoffe.",
    "i1": {
      "title": "STI-Bohrer und Gewindebohrer",
      "b1": {
        "h1": "Repariertes Gewinde",
        "h2": "STI-Bohrer (mm)",
        "h3": "Gewindebohrer",
        "h4": "Einsatzlängen"
      },
      "b2": {
        "t": "STI = Screw Thread Insert. Bohrer ≈ Nenndurchmesser + ¼ der Steigung (auf Normbohrer gerundet); Anleitung des Sets beachten. M14x1.25 ist das Zündkerzengewinde."
      }
    },
    "i2": {
      "title": "Einbau eines Drahtgewindeeinsatzes",
      "b1": {
        "l1": "Auf STI-Durchmesser bohren, genau rechtwinklig.",
        "l2": "Mit dem STI-Gewindebohrer schneiden, geschmiert, mit einer halben Umdrehung zurück, um den Span zu brechen.",
        "l3": "Gewinde ausblasen und reinigen.",
        "l4": "Einsatz mit dem Einbauwerkzeug bis ¼ bis ½ Umdrehung unter die Oberfläche eindrehen.",
        "l5": "Mitnehmerzapfen mit einem Durchschlag abbrechen (Einsätze mit Zapfen).",
        "l6": "Mit einer Schraube prüfen: Sie muss ohne Klemmen hineingehen."
      },
      "b2": {
        "t": "Edelstahleinsatz in Aluminium: Korrosionsschutzpaste auftragen, um Kontaktkorrosion zu vermeiden. Einen Einsatz nicht aus- und wieder einbauen: Er ist für einen dauerhaften Einbau gedacht."
      }
    },
    "i3": {
